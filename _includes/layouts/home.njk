---
layout: layouts/base.njk
header: home
---

<section class="section-hi">
  <div class="hi-left">
    <h1>{{ 'home.hi.title' | t }}</h1>
    <span>{{ 'home.hi.text1' | t }}<b>{{ 'home.hi.text2' | t }}</b>{{ 'home.hi.text3' | t }}</span>
    <span><a class="btn primary large" href='/contact'>{{ 'home.hi.button' | t }}</a></span>
  </div>
  <div class="hi-right">
    <div class="card-back">
      {% for item in hiBacks %}
        <div class="back-item hidden">
          <span class="back-label">{{ item.label }}</span>
          <div class="back-img" style="background-image: url('{{ item.img }}')"></div>
        </div>
      {% endfor %}     
    </div>
    <div class="card-front"></div>
  </div>
</section>

<section class="section-games">
  <div class="games-header">
    <h3>{{ 'home.games.title' | t }}</h3>
    <span><a class="btn primary small" href='/games'>{{ 'home.games.button' | t }}</a></span>
  </div>

  <div class="games-list">
    {% for item in collections[['games-', lang] | join] | reverse | firstNth(6) %}
      <a href="{{ item.page.url }}" class="game-item">
        <img alt="{{ item.data.title }}" src="{{ item.data.cover }}" />
      </a>
    {% endfor %}
  </div>
</section>

<section class="section-prototypes">
  <div class="proto-left">
    <h1>{{ 'home.prototypes.title' | t }}</h1>
    <span><a class="btn primary large" href='/prototypes'>{{ 'home.prototypes.button' | t }}</a></span>
  </div>

  <div class="proto-right"></div>
</section>

<section class="section-blog">
  <div class="blog-header">
    <h3>{{ 'home.blog.title' | t }}</h3>
    <span><a class="btn primary small" href='/blog'>{{ 'home.blog.button' | t }}</a></span>
  </div>

  <div class="post-list">
    {% for item in collections[['blog-', lang] | join] | reverse | firstNth(10) %}
      <div class="post-item">
        <span class="pill-wrapper">
          <span class="pill {{ item.data.pill }}">{{ item.data.category }}</span>
        </span>
        <a href="{{ item.page.url }}">{{ item.data.title }}</a>
      </div>
    {% endfor %}
  </div>
</section>

<script src="/assets/scripts/hi-card.js"></script>