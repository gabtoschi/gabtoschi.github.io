---
layout: layouts/base.njk
header: about
---

<section class="about-header">
  <div class="header-left"></div>
  <div class="header-right">
    <h1>{{ 'about.header.title' | t }}</h1>
    <h4>{{ 'about.header.subtitle' | t }}</h4>
  </div>
</section>

<section class="about-intro">
  {{ content | section('beforeCta') | safe }}
</section>

<section class="about-cta">
  <div class="cta-left">
    <h1>{{ 'about.cta.title' | t }}</h1>
    <h4>{{ 'about.cta.subtitle' | t }}</h4>
  </div>
  <div class="cta-right">
    <a href="/contact" class="btn primary large">{{ 'about.cta.button' | t }}</a>
  </div>
</section>

<section class="about-clipping">
  <h2>{{ 'about.clipping.title' | t }}</h2>

  <div class="clipping-list">
    {% for item in clipping %}
    <a target="_blank" href="{{ item.link }}">
      <span class="icon">{{ item.icon }}</span>
      <span class="label">{{ item.title }}</span>
    </a>
    {% endfor %}
  </div>
</section>

<section class="about-archive">
  {{ content | section('beforeArchive') | safe }}

  <div class="archive-grid">
    {% for item in archive %}
      <a target="_blank" href="{{ item.link }}">
        <img alt="{{ item.alt }}" src="{{ item.image }}" />
      </a>
    {% endfor %}
  </div>
</section>